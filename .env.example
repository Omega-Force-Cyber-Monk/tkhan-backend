NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tkhan_server?schema=public
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Tkhan
ADMIN_EMAIL=admin@tkhan.local
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Platform Admin
ADMIN_PHONE=+10000000000
# Set true only if the older demo admin@gmail.com account is still needed.
SEED_LEGACY_ADMIN=false

# --- Stripe -------------------------------------------------------------
# Staging/test backend (used by the TEST app build): sk_test_/pk_test_ keys,
# STRIPE_MODE=test, its own database and its own webhook endpoint.
# Production backend (used by the LIVE app): sk_live_/pk_live_ keys,
# STRIPE_MODE=live. The server refuses to start if keys and mode don't match.
# NOTE: .env.example is loaded as a fallback by ConfigModule, so mode and
# publishable key are left commented here - set them in the real environment.
# STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_change_me
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_CURRENCY=cad
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/groomer/connect/return
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/groomer/connect/refresh
STRIPE_CONNECT_PAYOUT_INTERVAL=daily
STRIPE_CONNECT_PAYOUT_DELAY_DAYS=minimum
# Required only when STRIPE_CONNECT_PAYOUT_INTERVAL=weekly.
STRIPE_CONNECT_PAYOUT_WEEKLY_DAY=friday
# Required only when STRIPE_CONNECT_PAYOUT_INTERVAL=monthly.
STRIPE_CONNECT_PAYOUT_MONTHLY_DAY=1
PLATFORM_FEE_PERCENT=10
BOOKING_REMINDER_CHECK_MINUTES=5
REVIEW_REMINDER_CHECK_MINUTES=5
REVIEW_REMINDER_DELAY_HOURS=24
GROOMER_AVAILABILITY_ALERT_CHECK_HOURS=6
GROOMER_AVAILABILITY_ALERT_LOOKAHEAD_DAYS=14
GROOMER_AVAILABILITY_LOW_SLOT_THRESHOLD=3
GROOMER_AVAILABILITY_EXPIRING_DAYS=7
GROOMER_AVAILABILITY_ALERT_THROTTLE_DAYS=7
BUYER_GROWTH_ALERT_CHECK_HOURS=12
BUYER_INACTIVE_ALERT_DAYS=30
BUYER_INACTIVE_ALERT_THROTTLE_DAYS=30
BUYER_REPEAT_REMINDER_DAYS=45
BUYER_REPEAT_REMINDER_THROTTLE_DAYS=30
BUYER_FAVORITE_AVAILABILITY_RECENT_HOURS=24
BUYER_FAVORITE_AVAILABILITY_LOOKAHEAD_DAYS=7
BUYER_FAVORITE_AVAILABILITY_THROTTLE_DAYS=7
BUYER_LAST_MINUTE_AVAILABILITY_HOURS=24
BUYER_LAST_MINUTE_AVAILABILITY_THROTTLE_DAYS=3
UPLOAD_STORAGE=minio
MINIO_ENDPOINT=https://minio.karoot.ca
MINIO_PUBLIC_BASE_URL=https://minio.karoot.ca/karoot
MINIO_BUCKET=karoot
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me

# Optional fallback if UPLOAD_STORAGE=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SEED_DEMO_USERS=false

# --- Cancellation & refund policy ----------------------------------------
# Slot times are stored as local wall-clock times; this zone is used to work
# out "hours before the appointment".
BUSINESS_TIME_ZONE=America/Toronto
CANCEL_BUYER_FULL_REFUND_HOURS=24
CANCEL_BUYER_LATE_HOURS=3
CANCEL_BUYER_LATE_REFUND_PERCENT=70
# Refund % when the buyer cancels between 3 and 24 hours before
# (confirmed by client: 100%). The late cancellation fee is kept by the platform.
CANCEL_BUYER_MID_WINDOW_REFUND_PERCENT=100
CANCEL_GROOMER_NO_SHOW_HOURS=24
GROOMER_NO_SHOW_WINDOW_DAYS=90
GROOMER_NO_SHOW_SUSPEND_AT=2
GROOMER_NO_SHOW_BLOCK_AT=3
GROOMER_NO_SHOW_SUSPENSION_DAYS=14
# Turn on once every app build in the stores sends acceptedTerms=true.
REQUIRE_BOOKING_TERMS_ACCEPTANCE=false
